# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/medisync
# Production: mongodb+srv://username:password@cluster.mongodb.net/medisync

# JWT Secret (Change this in production!)
JWT_SECRET=medisync-ultra-secure-secret-key-change-this-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
# Production: https://your-frontend.vercel.app

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# OCR Service (Optional)
GOOGLE_CLOUD_VISION_API_KEY=your-google-vision-api-key

# Payment Gateway (Optional)
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
