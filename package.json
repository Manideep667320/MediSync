{
  "name": "medisync-fullstack",
  "version": "1.0.0",
  "description": "MediSync - Digital Prescription & Pharmacy Coordination Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "seed": "cd backend && npm run seed",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm install && npm run build",
    "vercel-build": "cd frontend && npm install && npm run build"
  },
  "keywords": [
    "healthcare",
    "prescription",
    "pharmacy"
  ],
  "author": "MediSync Team",
  "license": "MIT",
  "dependencies": {
    "assemblyai": "^4.26.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.4",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
